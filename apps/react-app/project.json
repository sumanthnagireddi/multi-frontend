{
  "name": "react-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react-app/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/react-app/build"
      ],
      "options": {
        "cwd": "apps/react-app",
        "command": "npx -p node@22 node ../../node_modules/@react-router/dev/dist/cli/index.js build ."
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/react-app",
        "command": "npx -p node@22 node ../../node_modules/@react-router/dev/dist/cli/index.js dev . --host localhost --port 4201"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/react-app",
        "command": "npx -p node@22 node ../../node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
