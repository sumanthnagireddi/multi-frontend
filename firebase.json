{
  "database": {
    "rules": {
      "rules": {
        ".read": true,
        ".write": false
      }
    }
  },
  "hosting": [
    {
      "target": "angular-app",
      "public": "dist/apps/angular-app/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/ngsw-worker.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "/ngsw.json",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "/icon-**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
          ]
        },
        {
          "source": "/**/*.js",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/**/*.css",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "react-app",
      "public": "apps/react-app/build/client",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/manifest.json",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "next-app",
      "public": "apps/next-app/out",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "/icon-**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
